{
  "name": "@forbes/config",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./eslint/base": "./eslint/base.mjs"
  },
  "files": [
    "dist",
    "eslint"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  }
}
